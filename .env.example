# Copy to .env and set your own values. .env is git-ignored. Never commit real credentials.
POSTGRES_USER=vehicles
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vehicles

# Used when running backend / DeepStream outside Docker (host -> published port)
DATABASE_URL=postgresql://vehicles:change-me@localhost:5432/vehicles
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: HLS URL of the live feed for the dashboard (bonus)
VITE_HLS_URL=
